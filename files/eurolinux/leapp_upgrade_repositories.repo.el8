[certify-baseos]
name = EuroLinux certify BaseOS
baseurl=https://vault.cdn.euro-linux.com/legacy/eurolinux/8/8/BaseOS/$basearch/os
enabled=1
gpgcheck=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/8/RPM-GPG-KEY-eurolinux8
skip_if_unavailable=1

[certify-appstream]
name = EuroLinux certify AppStream
baseurl=https://vault.cdn.euro-linux.com/legacy/eurolinux/8/8/AppStream/$basearch/os
