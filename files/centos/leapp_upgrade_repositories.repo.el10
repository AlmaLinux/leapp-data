[centos10-baseos]
name=CentOS-10-stream - Base
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/BaseOS/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/BaseOS/$basearch/os/
gpgcheck=1
enabled=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256

[centos10-appstream]
name=CentOS-10-stream - AppStream
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/AppStream/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/AppStream/$basearch/os/
gpgcheck=1
enabled=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256

[centos10-crb]
name=CentOS-10-stream - CRB
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/CRB/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/CRB/$basearch/os/
gpgcheck=1
enabled=0
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256

[centos10-ha]
name=CentOS-10-stream - HA
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/HighAvailability/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/HighAvailability/$basearch/os/
gpgcheck=1
enabled=0
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256

[centos10-extras]
name=CentOS-10-stream - Extras
#metalink=https://mirrors.centos.org/metalink?repo=centos-extras-sig-extras-common-10-stream&arch=$basearch&protocol=https,http
baseurl=https://mirror.stream.centos.org/SIGs/10-stream/extras/$basearch/extras-common/
gpgcheck=1
enabled=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-CentOS-SIG-Extras-SHA512

[centos10-nfv]
name=CentOS-10-stream - NFV
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/NFV/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/NFV/x86_64/os/
gpgcheck=1
enabled=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256

[centos10-rt]
name=CentOS-10-stream - RT
mirrorlist=https://mirrors.centos.org/mirrorlist?path=/10-stream/RT/$basearch/os/
#baseurl=http://mirror.stream.centos.org/10-stream/RT/x86_64/os/
gpgcheck=1
enabled=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-centosofficial-SHA256
