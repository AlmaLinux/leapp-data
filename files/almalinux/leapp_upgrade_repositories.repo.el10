[almalinux10-baseos]
name=AlmaLinux 10.0-beta - BaseOS
mirrorlist=https://mirrors.almalinux.org/mirrorlist/10.0-beta/baseos
# baseurl=https://vault.almalinux.org/10.0-beta/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/rpm-gpg/10/RPM-GPG-KEY-AlmaLinux-10

